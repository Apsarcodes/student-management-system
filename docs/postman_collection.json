{
  "info": {
    "name": "Student Management System API",
    "_postman_id": "8a1ead53-0842-4f89-8dff-99d7d2fee5df",
    "description": "Complete REST API collection for Student Management System with JWT Authentication, Student CRUD, Departments, Courses, Subjects, Attendance, Marks, and Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin@university.edu\",\n  \"password\": \"{{adminPassword}}\",\n  \"rememberMe\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Faculty Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"faculty@university.edu\",\n  \"password\": \"{{facultyPassword}}\",\n  \"rememberMe\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Student Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"student@university.edu\",\n  \"password\": \"{{studentPassword}}\",\n  \"rememberMe\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard",
      "item": [
        {
          "name": "Get Dashboard Metrics & Charts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["dashboard", "stats"] }
          }
        }
      ]
    },
    {
      "name": "3. Students",
      "item": [
        {
          "name": "List Students (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/students?page=0&size=10&sortBy=id&sortDirection=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["students"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "id" },
                { "key": "sortDirection", "value": "DESC" },
                { "key": "search", "value": "Alexander", "disabled": true },
                { "key": "departmentId", "value": "1", "disabled": true },
                { "key": "status", "value": "Active", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Student Profile by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/students/1/profile", "host": ["{{baseUrl}}"], "path": ["students", "1", "profile"] }
          }
        },
        {
          "name": "Create New Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU-2026-100\",\n  \"firstName\": \"Jordan\",\n  \"lastName\": \"Peterson\",\n  \"dateOfBirth\": \"2004-06-15\",\n  \"gender\": \"Male\",\n  \"email\": \"jordan.peterson@student.edu\",\n  \"phone\": \"+1-555-0399\",\n  \"address\": \"450 Academic Way, Austin, TX\",\n  \"departmentId\": 1,\n  \"courseId\": 1,\n  \"academicYear\": 2,\n  \"semester\": 3,\n  \"admissionDate\": \"2024-08-15\",\n  \"status\": \"Active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/students", "host": ["{{baseUrl}}"], "path": ["students"] }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU-2023-001\",\n  \"firstName\": \"Alexander\",\n  \"lastName\": \"Wright\",\n  \"dateOfBirth\": \"2004-03-15\",\n  \"gender\": \"Male\",\n  \"email\": \"alexander.wright@student.edu\",\n  \"phone\": \"+1-555-0101\",\n  \"address\": \"124 Maple Street, Seattle, WA\",\n  \"departmentId\": 1,\n  \"courseId\": 1,\n  \"academicYear\": 2,\n  \"semester\": 3,\n  \"admissionDate\": \"2023-08-15\",\n  \"status\": \"Active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/students/1", "host": ["{{baseUrl}}"], "path": ["students", "1"] }
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/students/100", "host": ["{{baseUrl}}"], "path": ["students", "100"] }
          }
        }
      ]
    },
    {
      "name": "4. Departments & Courses",
      "item": [
        {
          "name": "Get All Departments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] }
          }
        },
        {
          "name": "Get Courses by Department",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/courses?departmentId=1", "host": ["{{baseUrl}}"], "path": ["courses"], "query": [{ "key": "departmentId", "value": "1" }] }
          }
        },
        {
          "name": "Get Subjects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/subjects?courseId=1&semester=3", "host": ["{{baseUrl}}"], "path": ["subjects"], "query": [{ "key": "courseId", "value": "1" }, { "key": "semester", "value": "3" }] }
          }
        }
      ]
    },
    {
      "name": "5. Attendance & Marks",
      "item": [
        {
          "name": "Record Bulk Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectId\": 5,\n  \"attendanceDate\": \"2026-09-12\",\n  \"items\": [\n    { \"studentId\": 1, \"status\": \"PRESENT\", \"remarks\": \"On time\" },\n    { \"studentId\": 2, \"status\": \"PRESENT\", \"remarks\": \"Active\" },\n    { \"studentId\": 3, \"status\": \"ABSENT\", \"remarks\": \"Sick leave\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/attendance", "host": ["{{baseUrl}}"], "path": ["attendance"] }
          }
        },
        {
          "name": "Get Attendance by Subject & Date",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/attendance?subjectId=5&date=2026-09-01", "host": ["{{baseUrl}}"], "path": ["attendance"], "query": [{ "key": "subjectId", "value": "5" }, { "key": "date", "value": "2026-09-01" }] }
          }
        },
        {
          "name": "Record Bulk Marks",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectId\": 5,\n  \"items\": [\n    { \"studentId\": 1, \"internalMarks\": 19.5, \"assignmentMarks\": 20.0, \"examMarks\": 56.0 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/marks", "host": ["{{baseUrl}}"], "path": ["marks"] }
          }
        }
      ]
    }
  ]
}
